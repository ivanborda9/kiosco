# Base de datos Postgres (conseguí una gratis en neon.tech, supabase.com o similar)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Credenciales del panel de administración
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"

# Clave secreta para firmar la sesión de admin (usar una cadena larga y aleatoria)
ADMIN_SESSION_SECRET="cambiar-por-una-cadena-secreta-larga"

# Número de WhatsApp del negocio para coordinar pago/envío (formato internacional, sin +, sin espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# Nombre del negocio mostrado en el sitio
NEXT_PUBLIC_STORE_NAME="Mi Catálogo"
