# Base de datos Postgres (conseguí una gratis en neon.tech, supabase.com o similar)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Credenciales del panel de administración
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"

# Clave secreta para firmar las sesiones (admin y revendedoras). Usar una cadena larga y aleatoria.
ADMIN_SESSION_SECRET="cambiar-por-una-cadena-secreta-larga"

# El nombre de la tienda, el color principal, el banner y el número de WhatsApp
# ya NO se configuran acá: se editan desde /admin/configuracion una vez que el sitio está andando.

# Pago con tarjeta / Mercado Pago (opcional). Si no se configura, el checkout
# solo ofrece coordinar por WhatsApp. Ver instrucciones en el README.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
